# Meta Ads Autopilot by Ratnakar Content: credentials
# Copy this file to .env (same folder) and fill in your own values. Placeholders only.
# NEVER share, upload or paste your .env anywhere. It gives full access to your ads and orders.

# ---- Meta (required) ---- SETUP.md step 2
META_ACCESS_TOKEN=<system-user-access-token>
META_AD_ACCOUNT_ID=act_<your-ad-account-number>
META_PAGE_ID=<your-facebook-page-id>
META_PIXEL_ID=<your-pixel-or-dataset-id>
# Optional: Instagram account ID, so new ads also run under your Instagram name
META_INSTAGRAM_ACCOUNT_ID=
# Optional: API version (default v26.0)
# META_API_VERSION=v26.0

# ---- Shopify (required for profit, products and orders) ---- SETUP.md step 3
SHOPIFY_STORE_DOMAIN=<your-store>.myshopify.com
# Dev Dashboard app (new way, since 2026): client ID + secret
SHOPIFY_CLIENT_ID=<client-id>
SHOPIFY_CLIENT_SECRET=<client-secret>
# Only if you still have an OLD custom app made in the Shopify admin before 2026:
# SHOPIFY_ACCESS_TOKEN=<admin-api-access-token>

# ---- Shiprocket (optional: real shipping cost + RTO) ---- SETUP.md step 4
# Use the API user (Settings > API > Create API User), not your normal login
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
